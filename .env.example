# ============================
# Variables de entorno - distrito-api
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env a Git
# ============================

# URL de conexión a Neon PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=pon_aqui_una_clave_secreta_muy_larga_y_aleatoria

# Claves VAPID para Web Push Notifications
VAPID_PUBLIC_KEY=BBCJtzBn22IJcujyWlCCwtSAyWLfsiELTqWAjQcEiOuPX0yiad9P5LIpMJv5T8VwkHJU0vxLHTqFYImzLYWBQyU
VAPID_PRIVATE_KEY=tu_clave_privada_vapid_aqui
VAPID_EMAIL=mailto:tu@email.com

# Puerto del servidor (Render lo define automáticamente)
PORT=3001

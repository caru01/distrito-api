# ============================
# Variables de entorno - distrito-api
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env a Git
# ============================

# URL de conexión a Neon PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=pon_aqui_una_clave_secreta_muy_larga_y_aleatoria

# Claves VAPID para Web Push Notifications
VAPID_PUBLIC_KEY=tu_clave_publica_vapid_aqui
VAPID_PRIVATE_KEY=tu_clave_privada_vapid_aqui
VAPID_EMAIL=mailto:tu@email.com

# SMTP para recuperación de contraseña
EMAIL_USER=soporte@tu-dominio.com
EMAIL_PASS=tu_clave_smtp

# WhatsApp Business Platform / Cloud API oficial de Meta
# Usa la versión vigente habilitada para tu aplicación, por ejemplo vNN.N.
WHATSAPP_VERIFY_TOKEN=crea_un_token_aleatorio_para_verificar_el_webhook
WHATSAPP_ACCESS_TOKEN=tu_token_permanente_del_sistema
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_whatsapp_business_account_id
# Necesario para comprobar X-Hub-Signature-256 en cada POST de Meta.
WHATSAPP_APP_SECRET=tu_app_secret
WHATSAPP_GRAPH_API_VERSION=vNN.N
# Temporal durante la conexión inicial. Cambiar a false después de validar Meta.
WHATSAPP_WEBHOOK_LOG_PAYLOAD=true

# Puerto del servidor (Render lo define automáticamente)
PORT=3001

# Orígenes adicionales separados por coma para pruebas LAN o acceso por IP pública
# CORS_ORIGINS=http://192.168.1.80:5173,http://192.168.1.80:5174

# Identificación exigida/recomendada al consultar códigos de barras
OPEN_FOOD_FACTS_USER_AGENT=DistritoBG/1.0 (inventario; contacto@tu-dominio.com)

# Retención de datos operativos; ejecutar periódicamente con npm run db:prune
DELIVERY_LOCATION_RETENTION_DAYS=90
CRM_WEBHOOK_RETENTION_DAYS=90
CRM_JOB_RETENTION_DAYS=30
